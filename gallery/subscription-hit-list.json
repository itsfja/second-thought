                      "NAME": {
                        "shadow": {
                          "type": "text",
                          "fields": {
                            "TEXT": "subscription review done"
                          }
                        }
                      },
                      "N": {
                        "shadow": {
                          "type": "math_number",
                          "fields": {
                            "NUM": 90
                          }
                        }
                      }
