                    "type": "rb_agent_builtin",
                    "fields": {
                      "KIND": "email"
                    },
                    "next": {
                      "block": {
                        "type": "rb_agent_builtin",
                        "fields": {
                          "KIND": "ask"
                        },
                        "next": {
                          "block": {
                            "type": "rb_agent_builtin",
                            "fields": {
                              "KIND": "web"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "next": {
                "block": {
                  "type": "rb_result"
                }
              }
