        {
          "type": "rb_receive",
          "fields": {
            "MSG": "subs"
          },
          "next": {
            "block": {
              "type": "rb_agent",
              "fields": {
                "PLAN": false
              },
              "inputs": {
                "GOAL": {
                  "shadow": {
                    "type": "rb_longtext",
                    "fields": {
                      "TEXT": "Search my email from the last 90 days for receipts and renewal notices from subscriptions (streaming, software, apps, memberships, boxes). List each subscription once with what it costs a month and a year. Then ask me, in one question, which of them I've used in the last month. From my answer, suggest which to cancel, cheapest saving last, and for each, search the web for the page where it's cancelled and give its link."
                    }
                  }
                },
                "STEPS": {
                  "shadow": {
                    "type": "math_number",
                    "fields": {
                      "NUM": 14
                    }
                  }
                },
