{
  "format": "reflection-blocks",
  "version": 1,
  "name": "is-the-stack-healthy",
  "gallery": {
    "title": "Is the stack healthy?",
    "category": "home",
    "description": "Each morning, reads your Docker containers and sends you a Telegram message: restarts since yesterday, any unhealthy or stopped, memory against the machine's total, and errors in the latest logs. Each Sunday it says whether the machine needs more memory. It only reads: nothing is restarted.",
    "tip": "Needs Docker on this computer, or DOCKER_HOST for another one: best a socket proxy that allows only reading containers. See Connections, Docker.",
    "author": "itsfja",
    "runtime": "3.0.0"
  },
  "program": {
    "variables": [
      {
        "id": "g_containers",
        "name": "containers"
      },
      {
        "id": "g_stats",
