{
  "format": "reflection-blocks",
  "version": 1,
  "name": "whos-on-the-network",
  "gallery": {
    "title": "Who's on the network?",
    "category": "home",
    "description": "Each morning, reads who's on your UniFi network and how your UniFi devices are, and sends you a Telegram message about anything new since yesterday (by network), any device offline, and firmware waiting. It only reads: nothing is blocked or changed.",
    "tip": "Needs UNIFI_URL, UNIFI_API_KEY and UNIFI_CERT_SHA256 (--doctor shows it). Tell it which address ranges are your IoT and camera networks.",
    "author": "itsfja",
    "runtime": "3.0.0"
  },
  "program": {
    "variables": [
      {
        "id": "g_clients",
        "name": "clients"
      },
      {
        "id": "g_devices",
        "name": "devices"
      },
      {
        "id": "g_report",
        "name": "report"
      }
    ],
    "blocks": {
      "languageVersion": 0,
      "blocks": [
        {
          "type": "rb_start",
          "next": {
            "block": {
              "type": "rb_broadcast_wait",
              "inputs": {
                "MSG": {
                  "shadow": {
                    "type": "text",
                    "fields": {
                      "TEXT": "check"
                    }
                  }
                }
              }
            }
          },
          "x": 30,
          "y": 30
        },
        {
          "type": "rb_when_time",
          "fields": {
            "HOUR": 8,
            "MINUTE": 30,
            "DAYS": "every"
          },
          "next": {
            "block": {
              "type": "rb_broadcast_wait",
              "inputs": {
                "MSG": {
                  "shadow": {
                    "type": "text",
                    "fields": {
                      "TEXT": "check"
                    }
                  }
                }
              }
            }
          },
          "x": 550,
          "y": 30
        },
        {
          "type": "rb_receive",
          "fields": {
            "MSG": "check"
          },
          "next": {
            "block": {
              "type": "variables_set",
              "fields": {
                "VAR": {
                  "id": "g_clients"
                }
              },
              "inputs": {
                "VALUE": {
                  "block": {
                    "type": "rb_unifi_clients"
                  }
                }
              },
              "next": {
                "block": {
                  "type": "variables_set",
                  "fields": {
                    "VAR": {
                      "id": "g_devices"
                    }
                  },
                  "inputs": {
                    "VALUE": {
                      "block": {
                        "type": "rb_unifi_devices"
                      }
                    }
                  },
                  "next": {
                    "block": {
                      "type": "variables_set",
                      "fields": {
                        "VAR": {
                          "id": "g_report"
                        }
                      },
                      "inputs": {
                        "VALUE": {
                          "block": {
                            "type": "rb_ask",
                            "inputs": {
                              "TEXT": {
                                "block": {
                                  "type": "text_join",
                                  "inputs": {
                                    "ADD0": {
                                      "shadow": {
                                        "type": "rb_longtext",
                                        "fields": {
                                          "TEXT": "Report on my UniFi network in under 120 words. 192.168.30.x is IoT and 192.168.40.x is cameras. List any client that wasn't there yesterday, by network, with a guess at its maker from the MAC address; any UniFi device that isn't online; and any with firmware waiting. If nothing is new, say so in one line.\n\nClients now:\n"
                                        }
                                      }
                                    },
                                    "ADD1": {
                                      "block": {
                                        "type": "variables_get",
                                        "fields": {
                                          "VAR": {
                                            "id": "g_clients"
                                          }
                                        }
                                      }
                                    },
                                    "ADD2": {
                                      "shadow": {
                                        "type": "rb_longtext",
                                        "fields": {
                                          "TEXT": "\n\nClients yesterday (empty the first day):\n"
                                        }
                                      }
                                    },
                                    "ADD3": {
                                      "block": {
                                        "type": "rb_mem_get",
                                        "inputs": {
                                          "NAME": {
                                            "shadow": {
                                              "type": "text",
                                              "fields": {
                                                "TEXT": "UniFi clients yesterday"
                                              }
                                            }
                                          }
                                        }
                                      }
                                    },
                                    "ADD4": {
                                      "shadow": {
                                        "type": "rb_longtext",
                                        "fields": {
                                          "TEXT": "\n\nUniFi devices:\n"
                                        }
                                      }
                                    },
                                    "ADD5": {
                                      "block": {
                                        "type": "variables_get",
                                        "fields": {
                                          "VAR": {
                                            "id": "g_devices"
                                          }
                                        }
                                      }
                                    }
                                  },
                                  "extraState": {
                                    "itemCount": 6
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "next": {
                        "block": {
                          "type": "rb_mem_set",
                          "fields": {
                            "KIND": "permanent"
                          },
                          "inputs": {
                            "VALUE": {
                              "block": {
                                "type": "variables_get",
                                "fields": {
                                  "VAR": {
                                    "id": "g_clients"
                                  }
                                }
                              }
                            },
                            "NAME": {
                              "shadow": {
                                "type": "text",
                                "fields": {
                                  "TEXT": "UniFi clients yesterday"
                                }
                              }
                            }
                          },
                          "next": {
                            "block": {
                              "type": "rb_tg_send",
                              "inputs": {
                                "TEXT": {
                                  "block": {
                                    "type": "variables_get",
                                    "fields": {
                                      "VAR": {
                                        "id": "g_report"
                                      }
                                    }
                                  }
                                }
                              },
                              "next": {
                                "block": {
                                  "type": "rb_finish_with",
                                  "inputs": {
                                    "TEXT": {
                                      "block": {
                                        "type": "variables_get",
                                        "fields": {
                                          "VAR": {
                                            "id": "g_report"
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "x": 30,
          "y": 290
        }
      ]
    }
  }
}
