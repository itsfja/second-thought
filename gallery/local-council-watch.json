{
  "format": "reflection-blocks",
  "version": 1,
  "name": "local-council-watch",
  "gallery": {
    "title": "Council agenda watch",
    "category": "news",
    "description": "Watches your council's agenda page and emails you when an item matches your topics, with the meeting and its date.",
    "tip": "Change the page to your council's agendas and the topics in the first block. Agendas only in PDFs can't be watched.",
    "author": "itsfja",
    "runtime": "2.2.0"
  },
  "program": {
    "variables": [
      {
        "id": "g_topics",
        "name": "topics"
      },
      {
        "id": "g_hits",
        "name": "hits"
      }
    ],
    "blocks": {
      "languageVersion": 0,
      "blocks": [
        {
          "type": "rb_start",
          "next": {
            "block": {
              "type": "rb_ask_me",
              "inputs": {
                "TEXT": {
                  "shadow": {
                    "type": "rb_longtext",
                    "fields": {
                      "TEXT": "Paste an agenda item to test with"
                    }
                  }
                }
              },
              "next": {
                "block": {
                  "type": "rb_broadcast_with_wait",
                  "inputs": {
                    "MSG": {
                      "shadow": {
                        "type": "text",
                        "fields": {
                          "TEXT": "agenda"
                        }
                      }
                    },
                    "VALUE": {
                      "block": {
                        "type": "rb_answer"
                      }
                    }
                  }
                }
              }
            }
          },
          "x": 30,
          "y": 30
        },
        {
          "type": "rb_page_when",
          "fields": {
            "URL": "https://example.com/council/agendas",
            "WORDS": "Agenda",
            "N": 720
          },
          "next": {
            "block": {
              "type": "rb_broadcast_with_wait",
              "inputs": {
                "MSG": {
                  "shadow": {
                    "type": "text",
                    "fields": {
                      "TEXT": "agenda"
                    }
                  }
                },
                "VALUE": {
                  "block": {
                    "type": "rb_event",
                    "fields": {
                      "KEY": "text"
                    }
                  }
                }
              }
            }
          },
          "x": 550,
          "y": 30
        },
        {
          "type": "rb_receive",
          "fields": {
            "MSG": "agenda"
          },
          "next": {
            "block": {
              "type": "variables_set",
              "fields": {
                "VAR": {
                  "id": "g_topics"
                }
              },
              "inputs": {
                "VALUE": {
                  "block": {
                    "type": "text",
                    "fields": {
                      "TEXT": "planning applications, bin collections, parking, cycle lanes"
                    }
                  }
                }
              },
              "next": {
                "block": {
                  "type": "variables_set",
                  "fields": {
                    "VAR": {
                      "id": "g_hits"
                    }
                  },
                  "inputs": {
                    "VALUE": {
                      "block": {
                        "type": "rb_ask",
                        "inputs": {
                          "TEXT": {
                            "block": {
                              "type": "text_join",
                              "inputs": {
                                "ADD0": {
                                  "shadow": {
                                    "type": "rb_longtext",
                                    "fields": {
                                      "TEXT": "This is what changed on a council's agenda page. List any items about these topics: "
                                    }
                                  }
                                },
                                "ADD1": {
                                  "block": {
                                    "type": "variables_get",
                                    "fields": {
                                      "VAR": {
                                        "id": "g_topics"
                                      }
                                    }
                                  }
                                },
                                "ADD2": {
                                  "shadow": {
                                    "type": "rb_longtext",
                                    "fields": {
                                      "TEXT": ". One line each: the item, the committee, and the meeting date. If none match, reply exactly: nothing\n\n"
                                    }
                                  }
                                },
                                "ADD3": {
                                  "block": {
                                    "type": "rb_msg_value"
                                  }
                                }
                              },
                              "extraState": {
                                "itemCount": 4
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "next": {
                    "block": {
                      "type": "controls_if",
                      "inputs": {
                        "IF0": {
                          "block": {
                            "type": "rb_contains",
                            "inputs": {
                              "A": {
                                "block": {
                                  "type": "variables_get",
                                  "fields": {
                                    "VAR": {
                                      "id": "g_hits"
                                    }
                                  }
                                }
                              },
                              "B": {
                                "shadow": {
                                  "type": "text",
                                  "fields": {
                                    "TEXT": "nothing"
                                  }
                                }
                              }
                            }
                          }
                        },
                        "DO0": {
                          "block": {
                            "type": "rb_finish_with",
                            "inputs": {
                              "TEXT": {
                                "shadow": {
                                  "type": "text",
                                  "fields": {
                                    "TEXT": "Nothing on the agenda for your topics."
                                  }
                                }
                              }
                            }
                          }
                        },
                        "ELSE": {
                          "block": {
                            "type": "rb_email_send",
                            "inputs": {
                              "TO": {
                                "shadow": {
                                  "type": "text",
                                  "fields": {
                                    "TEXT": "you@example.com"
                                  }
                                }
                              },
                              "SUBJECT": {
                                "shadow": {
                                  "type": "text",
                                  "fields": {
                                    "TEXT": "On the council agenda"
                                  }
                                }
                              },
                              "TEXT": {
                                "block": {
                                  "type": "variables_get",
                                  "fields": {
                                    "VAR": {
                                      "id": "g_hits"
                                    }
                                  }
                                }
                              }
                            },
                            "next": {
                              "block": {
                                "type": "rb_finish_with",
                                "inputs": {
                                  "TEXT": {
                                    "block": {
                                      "type": "variables_get",
                                      "fields": {
                                        "VAR": {
                                          "id": "g_hits"
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "extraState": {
                        "hasElse": true
                      }
                    }
                  }
                }
              }
            }
          },
          "x": 30,
          "y": 290
        }
      ]
    }
  }
}
