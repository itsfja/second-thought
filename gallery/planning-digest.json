{
  "format": "reflection-blocks",
  "version": 1,
  "name": "planning-digest",
  "gallery": {
    "title": "Planning digest",
    "category": "news",
    "description": "Each Friday, a digest of new planning applications near a postcode: what's proposed, where, and the date comments close, with a link for each. Nothing without a source.",
    "tip": "Change the postcode in the first block. Councils publish differently, so check the first digest against your council's portal.",
    "author": "itsfja",
    "runtime": "2.2.0"
  },
  "program": {
    "variables": [
      {
        "id": "g_postcode",
        "name": "postcode"
      }
    ],
    "blocks": {
      "languageVersion": 0,
      "blocks": [
        {
          "type": "rb_start",
          "next": {
            "block": {
              "type": "rb_broadcast_wait",
              "inputs": {
                "MSG": {
                  "shadow": {
                    "type": "text",
                    "fields": {
                      "TEXT": "planning"
                    }
                  }
                }
              }
            }
          },
          "x": 30,
          "y": 30
        },
        {
          "type": "rb_when_time",
          "fields": {
            "HOUR": 7,
            "MINUTE": 30,
            "DAYS": "weekdays"
          },
          "next": {
            "block": {
              "type": "controls_if",
              "inputs": {
                "IF0": {
                  "block": {
                    "type": "logic_compare",
                    "fields": {
                      "OP": "EQ"
                    },
                    "inputs": {
                      "A": {
                        "block": {
                          "type": "rb_now",
                          "fields": {
                            "PART": "weekday"
                          }
                        }
                      },
                      "B": {
                        "shadow": {
                          "type": "text",
                          "fields": {
                            "TEXT": "Friday"
                          }
                        }
                      }
                    }
                  }
                },
                "DO0": {
                  "block": {
                    "type": "rb_broadcast_wait",
                    "inputs": {
                      "MSG": {
                        "shadow": {
                          "type": "text",
                          "fields": {
                            "TEXT": "planning"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "x": 550,
          "y": 30
        },
        {
          "type": "rb_receive",
          "fields": {
            "MSG": "planning"
          },
          "next": {
            "block": {
              "type": "variables_set",
              "fields": {
                "VAR": {
                  "id": "g_postcode"
                }
              },
              "inputs": {
                "VALUE": {
                  "block": {
                    "type": "text",
                    "fields": {
                      "TEXT": "SE1 7PB"
                    }
                  }
                }
              },
              "next": {
                "block": {
                  "type": "rb_agent",
                  "fields": {
                    "PLAN": false
                  },
                  "inputs": {
                    "GOAL": {
                      "block": {
                        "type": "text_join",
                        "inputs": {
                          "ADD0": {
                            "shadow": {
                              "type": "rb_longtext",
                              "fields": {
                                "TEXT": "Find planning applications submitted in the last week within about a mile of "
                              }
                            }
                          },
                          "ADD1": {
                            "block": {
                              "type": "variables_get",
                              "fields": {
                                "VAR": {
                                  "id": "g_postcode"
                                }
                              }
                            }
                          },
                          "ADD2": {
                            "shadow": {
                              "type": "rb_longtext",
                              "fields": {
                                "TEXT": ". Search the web (the local council's planning portal, and planning news sites) and read the pages. For each: the address, what's proposed in one plain sentence, the reference, the date comments close, and the link. Recall the note 'planning seen' and leave out applications already in it, then remember this week's references as 'planning seen'. Check it with review_text against: every application has a link; nothing invented; plain English."
                              }
                            }
                          }
                        },
                        "extraState": {
                          "itemCount": 3
                        }
                      }
                    },
                    "STEPS": {
                      "shadow": {
                        "type": "math_number",
                        "fields": {
                          "NUM": 16
                        }
                      }
                    },
                    "TOOLS": {
                      "block": {
                        "type": "rb_agent_builtin",
                        "fields": {
                          "KIND": "web"
                        },
                        "next": {
                          "block": {
                            "type": "rb_agent_builtin",
                            "fields": {
                              "KIND": "memory"
                            },
                            "next": {
                              "block": {
                                "type": "rb_agent_builtin",
                                "fields": {
                                  "KIND": "review"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "next": {
                    "block": {
                      "type": "rb_email_send",
                      "inputs": {
                        "TO": {
                          "shadow": {
                            "type": "text",
                            "fields": {
                              "TEXT": "you@example.com"
                            }
                          }
                        },
                        "SUBJECT": {
                          "shadow": {
                            "type": "text",
                            "fields": {
                              "TEXT": "Planning applications near you"
                            }
                          }
                        },
                        "TEXT": {
                          "block": {
                            "type": "rb_draft"
                          }
                        }
                      },
                      "next": {
                        "block": {
                          "type": "rb_result"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "x": 30,
          "y": 290
        }
      ]
    }
  }
}
