{
  "format": "reflection-blocks",
  "version": 1,
  "name": "arxiv-fisher",
  "gallery": {
    "title": "arXiv fisher",
    "category": "news",
    "description": "Each morning, the five new arXiv papers closest to your interests, each with a plain-English paragraph on what they did and why it matters. Emailed to you.",
    "tip": "Put your arXiv category feeds in second-thought.ini, like feeds = https://rss.arxiv.org/rss/cs.AI, and your interests in the first block.",
    "author": "itsfja",
    "runtime": "2.2.0"
  },
  "program": {
    "variables": [
      {
        "id": "g_interests",
        "name": "interests"
      },
      {
        "id": "g_papers",
        "name": "papers"
      }
    ],
    "blocks": {
      "languageVersion": 0,
      "blocks": [
        {
          "type": "rb_start",
          "next": {
            "block": {
              "type": "rb_broadcast_wait",
              "inputs": {
                "MSG": {
                  "shadow": {
                    "type": "text",
                    "fields": {
                      "TEXT": "papers"
                    }
                  }
                }
              }
            }
          },
          "x": 30,
          "y": 30
        },
        {
          "type": "rb_when_time",
          "fields": {
            "HOUR": 6,
            "MINUTE": 0,
            "DAYS": "every"
          },
          "next": {
            "block": {
              "type": "rb_broadcast_wait",
              "inputs": {
                "MSG": {
                  "shadow": {
                    "type": "text",
                    "fields": {
                      "TEXT": "papers"
                    }
                  }
                }
              }
            }
          },
          "x": 550,
          "y": 30
        },
        {
          "type": "rb_receive",
          "fields": {
            "MSG": "papers"
          },
          "next": {
            "block": {
              "type": "variables_set",
              "fields": {
                "VAR": {
                  "id": "g_interests"
                }
              },
              "inputs": {
                "VALUE": {
                  "block": {
                    "type": "text",
                    "fields": {
                      "TEXT": "AI agents, evaluation, tool use"
                    }
                  }
                }
              },
              "next": {
                "block": {
                  "type": "variables_set",
                  "fields": {
                    "VAR": {
                      "id": "g_papers"
                    }
                  },
                  "inputs": {
                    "VALUE": {
                      "block": {
                        "type": "rb_feed_news",
                        "inputs": {
                          "URL": {
                            "shadow": {
                              "type": "text",
                              "fields": {
                                "TEXT": ""
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "next": {
                    "block": {
                      "type": "rb_task",
                      "inputs": {
                        "TEXT": {
                          "block": {
                            "type": "text_join",
                            "inputs": {
                              "ADD0": {
                                "shadow": {
                                  "type": "rb_longtext",
                                  "fields": {
                                    "TEXT": "These are new postings from my feeds (ignore anything that isn't an arXiv paper). My interests: "
                                  }
                                }
                              },
                              "ADD1": {
                                "block": {
                                  "type": "variables_get",
                                  "fields": {
                                    "VAR": {
                                      "id": "g_interests"
                                    }
                                  }
                                }
                              },
                              "ADD2": {
                                "shadow": {
                                  "type": "rb_longtext",
                                  "fields": {
                                    "TEXT": ". Pick the five most relevant. For each: the title and link, then one plain-English paragraph on what they did and why it matters, for someone who doesn't read papers.\n\n"
                                  }
                                }
                              },
                              "ADD3": {
                                "block": {
                                  "type": "variables_get",
                                  "fields": {
                                    "VAR": {
                                      "id": "g_papers"
                                    }
                                  }
                                }
                              }
                            },
                            "extraState": {
                              "itemCount": 4
                            }
                          }
                        }
                      },
                      "next": {
                        "block": {
                          "type": "rb_generate",
                          "next": {
                            "block": {
                              "type": "rb_review",
                              "inputs": {
                                "CRITERIA": {
                                  "shadow": {
                                    "type": "rb_longtext",
                                    "fields": {
                                      "TEXT": "five papers at most; each has its link; no jargon left unexplained"
                                    }
                                  }
                                }
                              },
                              "next": {
                                "block": {
                                  "type": "controls_if",
                                  "inputs": {
                                    "IF0": {
                                      "block": {
                                        "type": "logic_negate",
                                        "inputs": {
                                          "BOOL": {
                                            "block": {
                                              "type": "rb_passed"
                                            }
                                          }
                                        }
                                      }
                                    },
                                    "DO0": {
                                      "block": {
                                        "type": "rb_revise"
                                      }
                                    }
                                  },
                                  "next": {
                                    "block": {
                                      "type": "rb_email_send",
                                      "inputs": {
                                        "TO": {
                                          "shadow": {
                                            "type": "text",
                                            "fields": {
                                              "TEXT": "you@example.com"
                                            }
                                          }
                                        },
                                        "SUBJECT": {
                                          "shadow": {
                                            "type": "text",
                                            "fields": {
                                              "TEXT": "Five papers worth your time"
                                            }
                                          }
                                        },
                                        "TEXT": {
                                          "block": {
                                            "type": "rb_draft"
                                          }
                                        }
                                      },
                                      "next": {
                                        "block": {
                                          "type": "rb_result"
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "x": 30,
          "y": 290
        }
      ]
    }
  }
}
