{
  "format": "reflection-blocks",
  "version": 1,
  "name": "second-thought-doctor",
  "gallery": {
    "title": "Second Thought doctor",
    "category": "odds",
    "description": "Once a week, runs the same checks as --doctor on your keys and connections and emails you the report if anything needs fixing, before a program finds out the hard way.",
    "tip": "Point it at the second-thought.ini in your home folder, so it checks the keys every program shares. Only runs in exported Python.",
    "author": "itsfja",
    "runtime": "2.2.0"
  },
  "program": {
    "variables": [
      {
        "id": "g_report",
        "name": "report"
      }
    ],
    "blocks": {
      "languageVersion": 0,
      "blocks": [
        {
          "type": "rb_start",
          "next": {
            "block": {
              "type": "rb_broadcast_wait",
              "inputs": {
                "MSG": {
                  "shadow": {
                    "type": "text",
                    "fields": {
                      "TEXT": "checkup"
                    }
                  }
                }
              }
            }
          },
          "x": 30,
          "y": 30
        },
        {
          "type": "rb_when_time",
          "fields": {
            "HOUR": 8,
            "MINUTE": 0,
            "DAYS": "weekends"
          },
          "next": {
            "block": {
              "type": "controls_if",
              "inputs": {
                "IF0": {
                  "block": {
                    "type": "logic_compare",
                    "fields": {
                      "OP": "EQ"
                    },
                    "inputs": {
                      "A": {
                        "block": {
                          "type": "rb_now",
                          "fields": {
                            "PART": "weekday"
                          }
                        }
                      },
                      "B": {
                        "shadow": {
                          "type": "text",
                          "fields": {
                            "TEXT": "Sunday"
                          }
                        }
                      }
                    }
                  }
                },
                "DO0": {
                  "block": {
                    "type": "rb_broadcast_wait",
                    "inputs": {
                      "MSG": {
                        "shadow": {
                          "type": "text",
                          "fields": {
                            "TEXT": "checkup"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "x": 550,
          "y": 30
        },
        {
          "type": "rb_receive",
          "fields": {
            "MSG": "checkup"
          },
          "next": {
            "block": {
              "type": "variables_set",
              "fields": {
                "VAR": {
                  "id": "g_report"
                }
              },
              "inputs": {
                "VALUE": {
                  "block": {
                    "type": "rb_setup_check"
                  }
                }
              },
              "next": {
                "block": {
                  "type": "controls_if",
                  "inputs": {
                    "IF0": {
                      "block": {
                        "type": "rb_contains",
                        "inputs": {
                          "A": {
                            "block": {
                              "type": "variables_get",
                              "fields": {
                                "VAR": {
                                  "id": "g_report"
                                }
                              }
                            }
                          },
                          "B": {
                            "shadow": {
                              "type": "text",
                              "fields": {
                                "TEXT": "FAIL"
                              }
                            }
                          }
                        }
                      }
                    },
                    "DO0": {
                      "block": {
                        "type": "rb_email_send",
                        "inputs": {
                          "TO": {
                            "shadow": {
                              "type": "text",
                              "fields": {
                                "TEXT": "you@example.com"
                              }
                            }
                          },
                          "SUBJECT": {
                            "shadow": {
                              "type": "text",
                              "fields": {
                                "TEXT": "Second Thought: something to fix"
                              }
                            }
                          },
                          "TEXT": {
                            "block": {
                              "type": "variables_get",
                              "fields": {
                                "VAR": {
                                  "id": "g_report"
                                }
                              }
                            }
                          }
                        },
                        "next": {
                          "block": {
                            "type": "rb_finish_with",
                            "inputs": {
                              "TEXT": {
                                "block": {
                                  "type": "variables_get",
                                  "fields": {
                                    "VAR": {
                                      "id": "g_report"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "ELSE": {
                      "block": {
                        "type": "rb_finish_with",
                        "inputs": {
                          "TEXT": {
                            "block": {
                              "type": "text_join",
                              "inputs": {
                                "ADD0": {
                                  "shadow": {
                                    "type": "rb_longtext",
                                    "fields": {
                                      "TEXT": "All well.\n\n"
                                    }
                                  }
                                },
                                "ADD1": {
                                  "block": {
                                    "type": "variables_get",
                                    "fields": {
                                      "VAR": {
                                        "id": "g_report"
                                      }
                                    }
                                  }
                                }
                              },
                              "extraState": {
                                "itemCount": 2
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "extraState": {
                    "hasElse": true
                  }
                }
              }
            }
          },
          "x": 30,
          "y": 290
        }
      ]
    }
  }
}
