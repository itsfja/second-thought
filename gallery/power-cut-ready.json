               "block": {
                "type": "rb_ask",
                "inputs": {
                 "TEXT": {
                  "block": {
                   "type": "text_join",
                   "inputs": {
                    "ADD0": {
                     "shadow": {
                      "type": "rb_longtext",
                      "fields": {
                       "TEXT": "Here are my Tesla Powerwall's figures and a check of tonight's weather warnings. In under 100 words: whether the house is ready for a power cut (enough charge, a sensible reserve), and what to do if not. If a severe weather warning applies tonight, start your reply with the word STORM on a line of its own.\n\nFigures:\n"
                      }
                     }
                    },
                    "ADD1": {
                     "block": {
                      "type": "variables_get",
                      "fields": {
                       "VAR": {
                        "id": "g_figures"
                       }
                      }
                     }
                    },
                    "ADD2": {
                     "shadow": {
                      "type": "rb_longtext",
                      "fields": {
                       "TEXT": "\n\nWeather check:\n"
                      }
                     }
                    },
                    "ADD3": {
                     "block": {
                      "type": "variables_get",
                      "fields": {
                       "VAR": {
                        "id": "g_warn"
                       }
                      }
                     }
                    }
                   },
                   "extraState": {
                    "itemCount": 4
                   }
                  }
                 }
                }
               }
              }
             },
             "next": {
              "block": {
               "type": "controls_if",
               "inputs": {
                "IF0": {
                 "block": {
                  "type": "rb_contains",
                  "inputs": {
                   "A": {
                    "block": {
                     "type": "variables_get",
                     "fields": {
                      "VAR": {
                       "id": "g_summary"
                      }
                     }
                    }
                   },
                   "B": {
