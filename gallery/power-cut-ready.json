                 },
                 "next": {
                  "block": {
                   "type": "rb_finish_with",
                   "inputs": {
                    "TEXT": {
                     "block": {
                      "type": "variables_get",
                      "fields": {
                       "VAR": {
                        "id": "g_summary"
                       }
                      }
                     }
                    }
                   }
                  }
                 }
                }
               }
              }
             }
            }
           }
          }
         }
        }
       }
      }
