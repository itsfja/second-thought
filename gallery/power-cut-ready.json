         "inputs": {
          "GOAL": {
           "shadow": {
            "type": "rb_longtext",
            "fields": {
             "TEXT": "Search the web for tonight's severe weather warnings for London, UK: wind, storm or flood warnings that apply tonight. Say plainly which warnings apply tonight, in under 60 words, or say 'no warnings tonight'."
            }
           }
          },
          "STEPS": {
           "shadow": {
            "type": "math_number",
            "fields": {
             "NUM": 4
            }
           }
          },
          "TOOLS": {
           "block": {
            "type": "rb_agent_builtin",
            "fields": {
             "KIND": "web"
            }
           }
          }
         },
         "next": {
          "block": {
