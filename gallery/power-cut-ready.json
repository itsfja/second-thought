{
 "format": "reflection-blocks",
 "version": 1,
 "name": "power-cut-ready",
 "gallery": {
  "title": "Power cut ready?",
  "category": "home",
  "description": "Each evening, reads your Tesla Powerwall's figures, checks tonight's severe weather warnings, and sends a Telegram message on whether the house is ready for a power cut. If a storm warning applies, it offers to raise the reserve to 100% — asking first. Otherwise it only reads.",
  "tip": "Needs a Powerwall, Powerwall 2 or Powerwall+ (the Powerwall 3 has no local web API) and the gateway's customer password. Change the town in the weather check to yours.",
  "author": "itsfja",
  "runtime": "3.0.0"
 },
 "program": {
  "blocks": {
   "languageVersion": 0,
