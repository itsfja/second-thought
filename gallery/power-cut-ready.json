      "block": {
       "type": "rb_broadcast_wait",
       "inputs": {
        "MSG": {
         "shadow": {
          "type": "text",
          "fields": {
           "TEXT": "storm"
          }
         }
        }
       }
      }
     },
     "x": 30,
     "y": 30
    },
    {
     "type": "rb_when_time",
     "fields": {
      "HOUR": 18,
      "MINUTE": 0,
      "DAYS": "every"
     },
     "next": {
      "block": {
       "type": "rb_broadcast_wait",
