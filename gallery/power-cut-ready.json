                    "shadow": {
                     "type": "math_number",
                     "fields": {
                      "NUM": 100
                     }
                    }
                   }
                  }
                 }
                }
               },
               "next": {
                "block": {
                 "type": "rb_tg_send",
                 "inputs": {
                  "TEXT": {
                   "block": {
