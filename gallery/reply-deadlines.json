{
  "format": "reflection-blocks",
  "version": 1,
  "name": "reply-deadlines",
  "gallery": {
    "title": "Reply deadlines",
    "category": "calendar",
    "description": "Each Monday morning, finds client emails that still need a reply, with the date each one asked for or the date you'd reasonably owe one, soonest first. Emailed to you; it never replies.",
    "tip": "Tell it who your clients are in the agent's goal (a domain, or the words in their signatures) to cut out newsletters.",
    "author": "itsfja",
    "runtime": "2.2.0"
  },
  "program": {
    "blocks": {
      "languageVersion": 0,
      "blocks": [
        {
          "type": "rb_start",
          "next": {
            "block": {
              "type": "rb_broadcast_wait",
              "inputs": {
                "MSG": {
                  "shadow": {
                    "type": "text",
                    "fields": {
                      "TEXT": "replies"
                    }
                  }
                }
              }
            }
          },
          "x": 30,
          "y": 30
        },
        {
          "type": "rb_when_time",
          "fields": {
            "HOUR": 8,
            "MINUTE": 0,
            "DAYS": "weekdays"
          },
          "next": {
            "block": {
              "type": "controls_if",
              "inputs": {
                "IF0": {
                  "block": {
                    "type": "logic_compare",
                    "fields": {
                      "OP": "EQ"
                    },
                    "inputs": {
                      "A": {
                        "block": {
                          "type": "rb_now",
                          "fields": {
                            "PART": "weekday"
                          }
                        }
                      },
                      "B": {
                        "shadow": {
                          "type": "text",
                          "fields": {
                            "TEXT": "Monday"
                          }
                        }
                      }
                    }
                  }
                },
                "DO0": {
                  "block": {
                    "type": "rb_broadcast_wait",
                    "inputs": {
                      "MSG": {
                        "shadow": {
                          "type": "text",
                          "fields": {
                            "TEXT": "replies"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "x": 550,
          "y": 30
        },
        {
          "type": "rb_receive",
          "fields": {
            "MSG": "replies"
          },
          "next": {
            "block": {
              "type": "rb_agent",
              "fields": {
                "PLAN": false
              },
              "inputs": {
                "GOAL": {
                  "shadow": {
                    "type": "rb_longtext",
                    "fields": {
                      "TEXT": "Search my email from the last 14 days for messages from clients that ask for something and haven't had a reply from me yet. Read them. For each: who, what they need, and the reply-by date: the date they asked for, or else five working days after it arrived (use time_plus). Soonest first, overdue ones marked OVERDUE. Leave out newsletters, receipts and anything already answered. Don't reply to anything."
                    }
                  }
                },
                "STEPS": {
                  "shadow": {
                    "type": "math_number",
                    "fields": {
                      "NUM": 16
                    }
                  }
                },
                "TOOLS": {
                  "block": {
                    "type": "rb_agent_builtin",
                    "fields": {
                      "KIND": "email"
                    },
                    "next": {
                      "block": {
                        "type": "rb_agent_builtin",
                        "fields": {
                          "KIND": "time"
                        }
                      }
                    }
                  }
                }
              },
              "next": {
                "block": {
                  "type": "rb_ask_first",
                  "fields": {
                    "WHAT": "messages"
                  },
                  "next": {
                    "block": {
                      "type": "rb_email_send",
                      "inputs": {
                        "TO": {
                          "shadow": {
                            "type": "text",
                            "fields": {
                              "TEXT": "you@example.com"
                            }
                          }
                        },
                        "SUBJECT": {
                          "shadow": {
                            "type": "text",
                            "fields": {
                              "TEXT": "Replies due this week"
                            }
                          }
                        },
                        "TEXT": {
                          "block": {
                            "type": "rb_draft"
                          }
                        }
                      },
                      "next": {
                        "block": {
                          "type": "rb_result"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "x": 30,
          "y": 290
        }
      ]
    }
  }
}
