{
  "format": "reflection-blocks",
  "version": 1,
  "name": "morning-cluster-check",
  "gallery": {
    "title": "Morning cluster check",
    "category": "home",
    "description": "Each morning, reads your Proxmox cluster and sends you a Telegram message: any node down, storage over 85%, last night's backups that failed, guests stopped that should start at boot, and anything else worth a look. It only reads: nothing is started or stopped.",
    "tip": "Needs PROXMOX_URL, PROXMOX_TOKEN_ID and PROXMOX_TOKEN_SECRET for a token with the PVEAuditor role, and PROXMOX_CERT_SHA256 (--doctor shows it).",
    "author": "itsfja",
    "runtime": "3.0.0"
  },
  "program": {
    "variables": [
      {
        "id": "g_nodes",
        "name": "nodes"
      },
      {
        "id": "g_guests",
        "name": "guests"
      },
      {
        "id": "g_storage",
        "name": "storage"
      },
      {
        "id": "g_tasks",
        "name": "tasks"
      },
      {
        "id": "g_report",
        "name": "report"
      }
    ],
    "blocks": {
      "languageVersion": 0,
      "blocks": [
        {
          "type": "rb_start",
          "next": {
            "block": {
              "type": "rb_broadcast_wait",
              "inputs": {
                "MSG": {
                  "shadow": {
                    "type": "text",
                    "fields": {
                      "TEXT": "check"
                    }
                  }
                }
              }
            }
          },
          "x": 30,
          "y": 30
        },
        {
          "type": "rb_when_time",
          "fields": {
            "HOUR": 7,
            "MINUTE": 30,
            "DAYS": "every"
          },
          "next": {
            "block": {
              "type": "rb_broadcast_wait",
              "inputs": {
                "MSG": {
                  "shadow": {
                    "type": "text",
                    "fields": {
                      "TEXT": "check"
                    }
                  }
                }
              }
            }
          },
          "x": 550,
          "y": 30
        },
        {
          "type": "rb_receive",
          "fields": {
            "MSG": "check"
          },
          "next": {
            "block": {
              "type": "variables_set",
              "fields": {
                "VAR": {
                  "id": "g_nodes"
                }
              },
              "inputs": {
                "VALUE": {
                  "block": {
                    "type": "rb_proxmox_nodes"
                  }
                }
              },
              "next": {
                "block": {
                  "type": "variables_set",
                  "fields": {
                    "VAR": {
                      "id": "g_guests"
                    }
                  },
                  "inputs": {
                    "VALUE": {
                      "block": {
                        "type": "rb_proxmox_guests"
                      }
                    }
                  },
                  "next": {
                    "block": {
                      "type": "variables_set",
                      "fields": {
                        "VAR": {
                          "id": "g_storage"
                        }
                      },
                      "inputs": {
                        "VALUE": {
                          "block": {
                            "type": "rb_proxmox_storage"
                          }
                        }
                      },
                      "next": {
                        "block": {
                          "type": "variables_set",
                          "fields": {
                            "VAR": {
                              "id": "g_tasks"
                            }
                          },
                          "inputs": {
                            "VALUE": {
                              "block": {
                                "type": "rb_proxmox_tasks",
                                "inputs": {
                                  "N": {
                                    "shadow": {
                                      "type": "math_number",
                                      "fields": {
                                        "NUM": 24
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "next": {
                            "block": {
                              "type": "variables_set",
                              "fields": {
                                "VAR": {
                                  "id": "g_report"
                                }
                              },
                              "inputs": {
                                "VALUE": {
                                  "block": {
                                    "type": "rb_ask",
                                    "inputs": {
                                      "TEXT": {
                                        "block": {
                                          "type": "text_join",
                                          "inputs": {
                                            "ADD0": {
                                              "shadow": {
                                                "type": "rb_longtext",
                                                "fields": {
                                                  "TEXT": "Check my Proxmox cluster in under 120 words: any node not online, any storage over 85% used, any task from the last 24 hours that didn't end OK (vzdump is a backup), and any guest that's stopped with onboot true. If all is well, say so in one line.\n\nNodes:\n"
                                                }
                                              }
                                            },
                                            "ADD1": {
                                              "block": {
                                                "type": "variables_get",
                                                "fields": {
                                                  "VAR": {
                                                    "id": "g_nodes"
                                                  }
                                                }
                                              }
                                            },
                                            "ADD2": {
                                              "shadow": {
                                                "type": "rb_longtext",
                                                "fields": {
                                                  "TEXT": "\n\nGuests:\n"
                                                }
                                              }
                                            },
                                            "ADD3": {
                                              "block": {
                                                "type": "variables_get",
                                                "fields": {
                                                  "VAR": {
                                                    "id": "g_guests"
                                                  }
                                                }
                                              }
                                            },
                                            "ADD4": {
                                              "shadow": {
                                                "type": "rb_longtext",
                                                "fields": {
                                                  "TEXT": "\n\nStorage:\n"
                                                }
                                              }
                                            },
                                            "ADD5": {
                                              "block": {
                                                "type": "variables_get",
                                                "fields": {
                                                  "VAR": {
                                                    "id": "g_storage"
                                                  }
                                                }
                                              }
                                            },
                                            "ADD6": {
                                              "shadow": {
                                                "type": "rb_longtext",
                                                "fields": {
                                                  "TEXT": "\n\nTasks:\n"
                                                }
                                              }
                                            },
                                            "ADD7": {
                                              "block": {
                                                "type": "variables_get",
                                                "fields": {
                                                  "VAR": {
                                                    "id": "g_tasks"
                                                  }
                                                }
                                              }
                                            }
                                          },
                                          "extraState": {
                                            "itemCount": 8
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              },
                              "next": {
                                "block": {
                                  "type": "rb_tg_send",
                                  "inputs": {
                                    "TEXT": {
                                      "block": {
                                        "type": "variables_get",
                                        "fields": {
                                          "VAR": {
                                            "id": "g_report"
                                          }
                                        }
                                      }
                                    }
                                  },
                                  "next": {
                                    "block": {
                                      "type": "rb_finish_with",
                                      "inputs": {
                                        "TEXT": {
                                          "block": {
                                            "type": "variables_get",
                                            "fields": {
                                              "VAR": {
                                                "id": "g_report"
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "x": 30,
          "y": 290
        }
      ]
    }
  }
}
