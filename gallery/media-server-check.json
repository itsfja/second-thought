{
  "format": "reflection-blocks",
  "version": 1,
  "name": "media-server-check",
  "gallery": {
    "title": "Media server check",
    "category": "home",
    "description": "Each morning, reads your Plex and Tautulli: whether the server's up, last night's streams (who watched what, and when), and the week's new items, and sends you a Telegram message. It only reads: nothing is scanned or stopped.",
    "tip": "Needs PLEX_URL, PLEX_TOKEN, TAUTULLI_URL and TAUTULLI_API_KEY in second-thought.ini. Change 2 to look further back, and 7 to a longer week.",
    "author": "itsfja",
    "runtime": "3.0.0"
  },
