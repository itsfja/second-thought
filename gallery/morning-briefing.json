                                  "shadow": {
                                    "type": "rb_longtext",
                                    "fields": {
                                      "TEXT": "In five short bullet points, each with its source, the most important things that happened overnight that someone in the UK should know this morning: world, UK, money, weather."
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "next": {
                    "block": {
                      "type": "rb_task",
                      "inputs": {
                        "TEXT": {
