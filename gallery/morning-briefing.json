                                "shadow": {
                                  "type": "rb_longtext",
                                  "fields": {
                                    "TEXT": "Write \"What you need to know today\": a short, calm briefing from these feed items and this overnight check. Most important first, one or two lines each, with its link or source.\n\nFeeds:\n"
                                  }
                                }
                              },
                              "ADD1": {
                                "block": {
                                  "type": "variables_get",
                                  "fields": {
                                    "VAR": {
                                      "id": "g_news"
                                    }
                                  }
                                }
                              },
                              "ADD2": {
                                "shadow": {
                                  "type": "rb_longtext",
                                  "fields": {
                                    "TEXT": "\n\nOvernight:\n"
                                  }
                                }
                              },
                              "ADD3": {
                                "block": {
                                  "type": "variables_get",
                                  "fields": {
                                    "VAR": {
                                      "id": "g_overnight"
                                    }
                                  }
                                }
                              }
                            },
                            "extraState": {
                              "itemCount": 4
                            }
                          }
                        }
                      },
                      "next": {
                        "block": {
