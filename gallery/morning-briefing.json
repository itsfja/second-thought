                                "block": {
                                  "type": "rb_email_send",
                                  "inputs": {
                                    "TO": {
                                      "shadow": {
                                        "type": "text",
                                        "fields": {
                                          "TEXT": "you@example.com"
                                        }
                                      }
                                    },
                                    "SUBJECT": {
                                      "shadow": {
                                        "type": "text",
                                        "fields": {
                                          "TEXT": "What you need to know today"
                                        }
                                      }
                                    },
                                    "TEXT": {
                                      "block": {
                                        "type": "rb_draft"
                                      }
                                    }
                                  },
                                  "next": {
                                    "block": {
                                      "type": "rb_result"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "x": 30,
          "y": 290
        }
