{
  "format": "reflection-blocks",
  "version": 1,
  "name": "kraken-week",
  "gallery": {
    "title": "Kraken week in review",
    "category": "money",
    "description": "Each Sunday evening, reads your Kraken balances and this week's prices, and emails what your holdings are worth in pounds, each one's share, and how each moved over the week. It only reads: it places no orders.",
    "tip": "Needs kraken-cli, and a Kraken API key that can only query. Change the email address in the email block to yours.",
    "author": "itsfja",
    "runtime": "3.0.0"
  },
  "program": {
    "blocks": {
      "languageVersion": 0,
      "blocks": [
        {
          "type": "rb_start",
          "next": {
            "block": {
              "type": "rb_broadcast_wait",
              "inputs": {
                "MSG": {
                  "shadow": {
                    "type": "text",
                    "fields": {
                      "TEXT": "review"
                    }
                  }
                }
              }
            }
          },
          "x": 30,
          "y": 30
        },
        {
          "type": "rb_when_time",
          "fields": {
            "HOUR": 18,
            "MINUTE": 0,
            "DAYS": "weekends"
          },
          "next": {
            "block": {
              "type": "controls_if",
              "inputs": {
                "IF0": {
                  "block": {
                    "type": "logic_compare",
                    "fields": {
                      "OP": "EQ"
                    },
                    "inputs": {
                      "A": {
                        "block": {
                          "type": "rb_now",
                          "fields": {
                            "PART": "weekday"
                          }
                        }
                      },
                      "B": {
                        "shadow": {
                          "type": "text",
                          "fields": {
                            "TEXT": "Sunday"
                          }
                        }
                      }
                    }
                  }
                },
                "DO0": {
                  "block": {
                    "type": "rb_broadcast_wait",
                    "inputs": {
                      "MSG": {
                        "shadow": {
                          "type": "text",
                          "fields": {
                            "TEXT": "review"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "x": 550,
          "y": 30
        },
        {
          "type": "rb_receive",
          "fields": {
            "MSG": "review"
          },
          "next": {
            "block": {
              "type": "rb_agent",
              "fields": {
                "PLAN": false
              },
              "inputs": {
                "GOAL": {
                  "shadow": {
                    "type": "rb_longtext",
                    "fields": {
                      "TEXT": "Read my Kraken balances. For each asset I hold, get its price in pounds today and seven days ago (daily OHLC). Then write a short summary: the total in pounds, each holding's value and share of the total, and how much each moved over the week, biggest moves first. Only read: don't place, change or cancel any orders."
                    }
                  }
                },
                "STEPS": {
                  "shadow": {
                    "type": "math_number",
                    "fields": {
                      "NUM": 10
                    }
                  }
                },
                "TOOLS": {
                  "block": {
                    "type": "rb_agent_kraken",
                    "fields": {
                      "MODE": "read"
                    }
                  }
                }
              },
              "next": {
                "block": {
                  "type": "rb_email_send",
                  "inputs": {
                    "TO": {
                      "shadow": {
                        "type": "text",
                        "fields": {
                          "TEXT": "you@example.com"
                        }
                      }
                    },
                    "SUBJECT": {
                      "shadow": {
                        "type": "text",
                        "fields": {
                          "TEXT": "Your Kraken week"
                        }
                      }
                    },
                    "TEXT": {
                      "block": {
                        "type": "rb_draft"
                      }
                    }
                  },
                  "next": {
                    "block": {
                      "type": "rb_result"
                    }
                  }
                }
              }
            }
          },
          "x": 30,
          "y": 290
        }
      ]
    }
  }
}
